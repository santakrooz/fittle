{
  "schema_version": 1,
  "notes": "Fittle-owned. Software fingerprints (who wrote the file) and vendor quirks (how to read what they wrote). Match patterns use the scope-profiles convention: case-insensitive, '*' is the only wildcard. 'verified' means checked against a real file. Roles: capture (wrote the raw data), processing (stacked/edited it), observatory (professional/archive origin).",
  "apps": [
    {
      "id": "seestar-app",
      "name": "ZWO Seestar",
      "role": "capture",
      "match": {
        "CREATOR": [
          "ZWO Seestar*"
        ],
        "INSTRUME": [
          "ZWO Seestar*",
          "Seestar*"
        ],
        "PRODUCER": [
          "ZWO"
        ]
      },
      "verified": true
    },
    {
      "id": "asiair",
      "name": "ZWO ASIAIR",
      "role": "capture",
      "match": {
        "CREATOR": [
          "ZWO *AIR",
          "ZWO ASIAIR*",
          "ASIAIR*"
        ],
        "SWCREATE": [
          "ASIAIR*",
          "ZWO ASIAIR*"
        ]
      },
      "verified": true
    },
    {
      "id": "nina",
      "name": "N.I.N.A.",
      "role": "capture",
      "match": {
        "SWCREATE": [
          "N.I.N.A.*",
          "NINA*"
        ]
      },
      "verified": true,
      "source": "header dump (NINA 3.2), github.com/geeksville/starbash doc/fits"
    },
    {
      "id": "sharpcap",
      "name": "SharpCap",
      "role": "capture",
      "match": {
        "SWCREATE": [
          "SharpCap*"
        ],
        "CREATOR": [
          "SharpCap*"
        ]
      },
      "verified": false,
      "source": "forums.sharpcap.co.uk t=4657"
    },
    {
      "id": "ekos",
      "name": "KStars / Ekos",
      "role": "capture",
      "match": {
        "CREATOR": [
          "KStars*",
          "Ekos*"
        ],
        "PROGRAM": [
          "KStars*",
          "Ekos*"
        ],
        "SWCREATE": [
          "KStars*",
          "Ekos*"
        ]
      },
      "verified": false,
      "comment": [
        "Generated by INDI"
      ],
      "source": "indilib/indi indiccd.cpp"
    },
    {
      "id": "apt",
      "name": "Astro Photography Tool",
      "role": "capture",
      "match": {
        "SWCREATE": [
          "Astro Photography Tool*"
        ],
        "CREATOR": [
          "Astro Photography Tool*"
        ]
      },
      "verified": false,
      "source": "header excerpt, kr8.de"
    },
    {
      "id": "sgp",
      "name": "Sequence Generator Pro",
      "role": "capture",
      "match": {
        "CREATOR": [
          "*Sequence Generator*"
        ],
        "SWCREATE": [
          "*Sequence Generator*"
        ]
      },
      "verified": false
    },
    {
      "id": "maxim",
      "name": "MaxIm DL",
      "role": "capture",
      "match": {
        "SWCREATE": [
          "MaxIm DL*"
        ],
        "SWMODIFY": [
          "MaxIm DL*"
        ]
      },
      "verified": false,
      "source": "Diffraction Limited FITS header definitions"
    },
    {
      "id": "dwarf-app",
      "name": "DWARFLAB Dwarf",
      "role": "capture",
      "match": {
        "ORIGIN": [
          "DWARFLAB*"
        ],
        "TELESCOP": [
          "DWARF*"
        ],
        "INSTRUME": [
          "DWARF*"
        ]
      },
      "verified": false,
      "source": "Dwarf 3 header dumps, github.com/geeksville/starbash doc/fits/dwarf3"
    },
    {
      "id": "vaonis",
      "name": "Vaonis (Vespera / Stellina)",
      "role": "capture",
      "match": {
        "TELESCOP": [
          "Vespera*",
          "Stellina*"
        ],
        "INSTRUME": [
          "Vespera*",
          "Stellina*"
        ],
        "CREATOR": [
          "Vaonis*",
          "Singularity*"
        ]
      },
      "verified": false,
      "source": "identifying values unknown; need a sample header"
    },
    {
      "id": "unistellar",
      "name": "Unistellar",
      "role": "capture",
      "match": {
        "ORIGIN": [
          "Unistellar*"
        ],
        "TELESCOP": [
          "eVscope*",
          "eQuinox*",
          "*odyssey*",
          "Unistellar*"
        ],
        "INSTRUME": [
          "IMX224*",
          "IMX347*",
          "IMX415*"
        ]
      },
      "verified": false,
      "present": [
        "FOVRA",
        "CMOSTEMP"
      ],
      "source": "nicastel/Siril-SmartScope-Scripts fixUnistellarHeaders.py; mikeprimm/evtools"
    },
    {
      "id": "siril",
      "name": "Siril",
      "role": "processing",
      "match": {
        "PROGRAM": [
          "Siril*"
        ],
        "SWCREATE": [
          "Siril*"
        ],
        "CREATOR": [
          "Siril*"
        ]
      },
      "history": [
        "siril",
        "stacking with",
        "Stacking:"
      ],
      "verified": true
    },
    {
      "id": "pixinsight",
      "name": "PixInsight",
      "role": "processing",
      "match": {
        "SWCREATE": [
          "PixInsight*"
        ],
        "CREATOR": [
          "PixInsight*"
        ],
        "PROGRAM": [
          "PixInsight*"
        ]
      },
      "history": [
        "ImageIntegration",
        "PixInsight"
      ],
      "verified": false,
      "comment": [
        "Integration with PixInsight"
      ]
    },
    {
      "id": "deepskystacker",
      "name": "DeepSkyStacker",
      "role": "processing",
      "match": {
        "SOFTWARE": [
          "DeepSkyStacker*"
        ],
        "CREATOR": [
          "DeepSkyStacker*"
        ],
        "SWCREATE": [
          "DeepSkyStacker*"
        ]
      },
      "history": [
        "DeepSkyStacker"
      ],
      "verified": false,
      "source": "DSS FITSUtil.cpp / StackedBitmap.cpp"
    },
    {
      "id": "astap",
      "name": "ASTAP",
      "role": "processing",
      "match": {
        "SWCREATE": [
          "ASTAP*"
        ],
        "CREATOR": [
          "ASTAP*"
        ],
        "PROGRAM": [
          "ASTAP*"
        ]
      },
      "history": [
        "Stacking method"
      ],
      "verified": false,
      "comment": [
        "Written by Astrometric Stacking Program*"
      ],
      "source": "han-k59/astap unit_stack.pas"
    },
    {
      "id": "stackingwizard",
      "name": "StackingWizard",
      "role": "processing",
      "present": [
        "WZNSUBS",
        "WZFPRNT"
      ],
      "verified": true
    },
    {
      "id": "graxpert",
      "name": "GraXpert",
      "role": "processing",
      "history": [
        "GraXpert"
      ],
      "verified": true
    },
    {
      "id": "hst",
      "name": "Hubble Space Telescope (STScI)",
      "role": "observatory",
      "match": {
        "TELESCOP": [
          "HST"
        ],
        "INSTRUME": [
          "WFPC2",
          "WFC3",
          "ACS",
          "STIS",
          "NICMOS"
        ],
        "ORIGIN": [
          "STScI-STSDAS*"
        ]
      },
      "verified": true
    },
    {
      "id": "eso",
      "name": "ESO (VLT / La Silla)",
      "role": "observatory",
      "match": {
        "TELESCOP": [
          "ESO-*"
        ],
        "ORIGIN": [
          "ESO*"
        ]
      },
      "verified": true
    },
    {
      "id": "dss",
      "name": "Digitized Sky Survey (STScI)",
      "role": "observatory",
      "match": {
        "ORIGIN": [
          "CASB -- STScI"
        ]
      },
      "present": [
        "PLATEID"
      ],
      "verified": true
    },
    {
      "id": "celestron-origin",
      "name": "Celestron Origin",
      "role": "capture",
      "match": {
        "CREATOR": [
          "*Origin*"
        ]
      },
      "verified": false,
      "source": "astrofiler file_processing.py (headers sparse; metadata in info.json)"
    }
  ],
  "quirks": [
    {
      "applies_to": [
        "zwo-seestar-*",
        "app:seestar-app"
      ],
      "keys": {
        "total_integration_s": [
          "TOTALEXP"
        ]
      },
      "ignore": [
        {
          "key": "APERTURE",
          "reason": "Seestar writes the aperture in cm (5 = 50 mm) under a misleading comment; using the model's aperture"
        }
      ],
      "serial": [
        {
          "key": "TELESCOP",
          "reason": "Seestar writes the device serial here, not a telescope name"
        }
      ],
      "row_order": "TOP-DOWN",
      "verified": true
    },
    {
      "applies_to": [
        "app:stackingwizard"
      ],
      "keys": {
        "stack_count": [
          "WZNSUBS"
        ]
      },
      "verified": true
    },
    {
      "applies_to": [
        "app:hst"
      ],
      "keys": {
        "object": [
          "TARGNAME"
        ],
        "filter": [
          "FILTNAM1"
        ]
      },
      "aliases": {
        "IMAGETYP": {
          "EXT": "Light"
        }
      },
      "verified": true
    },
    {
      "applies_to": [
        "app:dss"
      ],
      "scale": [
        {
          "key": "EXPOSURE",
          "factor": 60,
          "reason": "DSS plate headers give EXPOSURE in minutes"
        }
      ],
      "verified": true
    },
    {
      "applies_to": [
        "app:asiair",
        "app:apt",
        "app:ekos"
      ],
      "mount_in": [
        {
          "key": "TELESCOP",
          "patterns": [
            "*"
          ],
          "reason": "this app writes the mount driver name in TELESCOP, not the telescope"
        }
      ],
      "verified": true
    },
    {
      "applies_to": [
        "app:dwarf-app"
      ],
      "keys": {
        "sensor_temp_c": [
          "DET-TEMP"
        ]
      },
      "exptime_is_total": "stacked_file",
      "notes": [
        "Dwarf DATE-OBS is the END of the exposure",
        "Dwarf stack frame count lives in shotsInfo.json (shotsStacked), not the header"
      ],
      "verified": false
    },
    {
      "applies_to": [
        "app:unistellar"
      ],
      "keys": {
        "ra": [
          "FOVRA"
        ],
        "dec": [
          "FOVDEC"
        ],
        "sensor_temp_c": [
          "CMOSTEMP"
        ],
        "site_lat": [
          "LATITUDE"
        ],
        "site_lon": [
          "LONGITUD"
        ],
        "site_elev_m": [
          "ALTITUDE"
        ]
      },
      "verified": false
    },
    {
      "applies_to": [
        "app:vaonis"
      ],
      "row_order": "BOTTOM-UP",
      "verified": false
    },
    {
      "applies_to": [
        "app:maxim"
      ],
      "keys": {
        "stack_count": [
          "SNAPSHOT"
        ]
      },
      "verified": false
    },
    {
      "applies_to": [
        "app:pixinsight"
      ],
      "history_count": [
        "ImageIntegration.numberOfImages:"
      ],
      "verified": false
    },
    {
      "applies_to": [
        "app:deepskystacker"
      ],
      "exptime_is_total": "always",
      "verified": false
    },
    {
      "applies_to": [
        "app:astap"
      ],
      "exptime_is_total": "always",
      "keys": {
        "exposure_s": [
          "LUM_EXP"
        ],
        "stack_count": [
          "LUM_CNT"
        ]
      },
      "verified": false
    }
  ]
}
